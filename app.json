{
  "expo": {
    "name": "Sermonize",
    "slug": "sermonize",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "sermonize",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sermonize.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sermonize needs microphone access to record sermons for transcription and outlining.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.sermonize.app",
      "permissions": ["RECORD_AUDIO", "FOREGROUND_SERVICE", "WAKE_LOCK"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Sermonize needs microphone access to record sermons for transcription and outlining."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
