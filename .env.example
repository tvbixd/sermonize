# Copy this file to `.env` and fill in the values.
# Values starting with EXPO_PUBLIC_ are inlined into the JS bundle at build time
# and are visible to anyone who has the app. Do NOT put secrets here.

# Supabase — required for email/OAuth sign-in and account sync.
# Get these from https://app.supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# API.Bible — optional. Bundles a shared key into the app so users do not have
# to bring their own for scripture lookup. Without it, Scribe falls back to the
# public bible-api.com (smaller translation set).
# Get a free key at https://scripture.api.bible/
API_BIBLE_KEY=

# Transcription (Deepgram) + outlines (Anthropic/Claude). These are bundled into
# the app so it works with no per-user keys ("free to preach"). They are
# EXPO_PUBLIC_ (inlined into the bundle and extractable) — the safe long-term
# home for them is a server-side proxy. Put real values only in your local .env
# (gitignored) or as EAS env vars; never commit them.
EXPO_PUBLIC_DEEPGRAM_KEY=
# Outline engine. Gemini (free tier, default) is tried first, then Anthropic if set.
EXPO_PUBLIC_GEMINI_KEY=
EXPO_PUBLIC_ANTHROPIC_KEY=

# EAS Updates / OTA — set automatically by EAS when you run `eas update:configure`.
# Leave blank for local dev builds.
EAS_PROJECT_ID=
